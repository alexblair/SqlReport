# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.coverage

# 虚拟环境
venv/

# 环境变量
.env

# 临时文件
.tmp/
.scratch/

# 运行日志
run.log

# 运行时日志目录（测试日志、压测日志、基线 JSON、服务运行日志）。
# 本环境 /tmp 会被周期清空，且 nohup 后台进程活不过单次 bash 调用，
# 故一律落仓库内这些目录并忽略：run-logs/ 放测试与普通任务日志，
# perf-logs/ 放性能测量产物（scripts/perf 写入）。
# 这两个目录都可由 `scripts/agent/cleanup_tmp.py`（--apply）随时清空——勿把依据类内容留在里面。
run-logs/
perf-logs/

# 配置（含密码）
app_config.json
app_config.debug.json
*.debug.db
*.debug.log

# 数据库
config.db
audit.db

# 运行时缓存
static_cache/
static_cache_debug/
.opdev/
.pytest_cache/

# 公共 CSS/JS 外链化产物（内容 hash 版本锁目录，启动时生成）
static/vendor/self@*/

# 系统
.DS_Store
Thumbs.db

# CodeGraph
.codegraph/

# 文档与规范（本地使用，不提交）
SPEC.md
spec.md
CONTEXT.md

# flow 治理资产（本地使用，不提交；知识库主 SPEC/模块分卷/机器索引/访谈记录/flow 状态，主仓保持可安全推送 GitHub）
.adocs/

# 代理指引：仓库根 AGENTS.md 自 2026-10-06 起不再忽略（随仓库提交）

